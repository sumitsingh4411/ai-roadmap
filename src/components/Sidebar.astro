---
import { href } from '../lib/url';
import type { NavStage } from '../lib/curriculum';

interface Props {
  stages: NavStage[];
  currentSlug?: string;
}
const { stages, currentSlug } = Astro.props;
---
<details class="docs-nav" open>
  <summary>
    <span>Curriculum</span>
    <span class="nav-count" data-nav-count aria-hidden="true"></span>
  </summary>
  <nav aria-label="Lessons">
    {stages.map((stage) => (
      <div class="nav-stage">
        <p class="nav-stage-title">
          <span class="nav-stage-num">{String(stage.id).padStart(2, '0')}</span>
          {stage.name}
        </p>
        <ul>
          {stage.lessons.map((lesson) => (
            <li>
              <a
                href={href(`/lessons/${lesson.slug}`)}
                data-nav-slug={lesson.slug}
                aria-current={lesson.slug === currentSlug ? 'page' : undefined}
                class={lesson.slug === currentSlug ? 'active' : undefined}
              >
                <span class="nav-check" aria-hidden="true"></span>
                <span class="nav-label">{lesson.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</details>

<script>
  import { createProgressStore } from '../lib/progress';

  const store = createProgressStore();

  function paintNav() {
    const done = new Set(store.completed());
    let complete = 0;
    const links = document.querySelectorAll<HTMLElement>('[data-nav-slug]');
    for (const link of links) {
      const isDone = done.has(link.dataset.navSlug!);
      link.dataset.done = String(isDone);
      if (isDone) complete++;
    }
    const count = document.querySelector<HTMLElement>('[data-nav-count]');
    if (count) count.textContent = `${complete}/${links.length}`;
  }

  paintNav();
  window.addEventListener('storage', paintNav);
  window.addEventListener('pageshow', paintNav);
</script>

<style>
  .docs-nav {
    font-size: 0.9rem;
  }
  .docs-nav > summary {
    align-items: center;
    color: var(--text);
    cursor: pointer;
    display: flex;
    font-weight: 700;
    gap: 0.5rem;
    justify-content: space-between;
    list-style: none;
    padding: 0.5rem 0.25rem;
  }
  .docs-nav > summary::-webkit-details-marker { display: none; }
  .nav-count {
    color: var(--text-muted);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .docs-nav nav { margin-top: 0.5rem; }
  .nav-stage { margin-bottom: 1.15rem; }
  .nav-stage-title {
    align-items: baseline;
    color: var(--text-muted);
    display: flex;
    font-size: 0.72rem;
    font-weight: 700;
    gap: 0.45rem;
    letter-spacing: 0.06em;
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }
  .nav-stage-num { color: var(--accent); }
  .docs-nav ul { list-style: none; margin: 0; padding: 0; }
  .docs-nav li { margin: 0; }
  .docs-nav li a {
    align-items: center;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    display: flex;
    gap: 0.5rem;
    line-height: 1.3;
    padding: 0.3rem 0.5rem 0.3rem 0.7rem;
    text-decoration: none;
  }
  .docs-nav li a:hover { color: var(--text); }
  .docs-nav li a.active {
    border-left-color: var(--accent);
    color: var(--text);
    font-weight: 600;
  }
  .nav-check {
    border: 1.5px solid var(--border-bright);
    border-radius: 50%;
    flex-shrink: 0;
    height: 14px;
    position: relative;
    width: 14px;
  }
  [data-nav-slug][data-done='true'] .nav-check {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
  }
  [data-nav-slug][data-done='true'] .nav-check::after {
    color: #0b0a15;
    content: '✓';
    font-size: 9px;
    font-weight: 900;
    left: 50%;
    line-height: 1;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  [data-nav-slug][data-done='true'] .nav-label { color: var(--text-muted); }

  /* On wide screens the sidebar is always open; the summary is a mobile toggle. */
  @media (min-width: 901px) {
    .docs-nav > summary { display: none; }
    .docs-nav[open] nav,
    .docs-nav nav { display: block; }
  }
</style>
