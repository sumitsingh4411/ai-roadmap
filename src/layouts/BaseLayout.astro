---
import '../styles/theme.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
  /** Extra search keywords for this page, appended to the site defaults. */
  keywords?: string;
  /** Page-specific schema.org JSON-LD object(s). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, wide = false, keywords, jsonLd } = Astro.props;
const fullTitle = title === 'AI Roadmap'
  ? 'AI Roadmap — Learn AI from zero: 34 free lessons, Python to LLMs'
  : `${title} · AI Roadmap`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const DEFAULT_KEYWORDS =
  'learn AI, AI roadmap, machine learning roadmap, how to learn AI, AI for beginners, ' +
  'learn machine learning, deep learning tutorial, LLM tutorial, generative AI course, ' +
  'python for AI, free AI course, AI study plan, neural networks tutorial, transformers explained, ' +
  'RAG tutorial, PyTorch tutorial, data science roadmap';
const allKeywords = keywords ? `${keywords}, ${DEFAULT_KEYWORDS}` : DEFAULT_KEYWORDS;

// Site-wide structured data. Google understands this site is a learning resource.
const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AI Roadmap',
  url: 'https://sumitsingh4411.github.io/ai-roadmap/',
  description:
    'A free, open-source roadmap to learn AI from zero — 34 lessons from your first line of Python to shipping an LLM app.',
  inLanguage: 'en',
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://sumitsingh4411.github.io/ai-roadmap/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
const schemas = [siteSchema, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
const hasSidebar = Astro.slots.has('sidebar');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={allKeywords} />
    <meta name="author" content="AI Roadmap" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="AI Roadmap" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Structured data for search engines -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
    <!-- Applied before first paint so the page never flashes the wrong theme. -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('ai-roadmap:theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="brand" href={href('/')}>
        <span class="brand-mark" aria-hidden="true"></span>
        AI Roadmap
      </a>
      <nav>
        <a href={href('/')}>Home</a>
        <a href={href('/roadmap')}>Roadmap</a>
        <a href="https://github.com/sumitsingh4411/ai-roadmap" rel="noopener">GitHub</a>
        <SearchDialog />
        <ThemeToggle />
      </nav>
    </header>

    {hasSidebar ? (
      <div class="docs-shell">
        <aside class="docs-aside">
          <div class="docs-aside-inner">
            <slot name="sidebar" />
          </div>
        </aside>
        <main id="main">
          <slot />
        </main>
      </div>
    ) : (
      <main id="main" class={wide ? 'wide' : ''}>
        <slot />
      </main>
    )}

    <footer class="site-footer">
      <p>
        Free and open source. Code MIT, content CC BY 4.0 ·
        <a href="https://github.com/sumitsingh4411/ai-roadmap" rel="noopener">Contribute on GitHub</a>
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    align-items: center;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
    justify-content: space-between;
    padding: 1rem clamp(1rem, 4vw, 2.5rem);
  }
  .brand {
    align-items: center;
    color: var(--text);
    display: flex;
    font-weight: 700;
    gap: 0.55rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .brand-mark {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-radius: 6px;
    box-shadow: 0 0 18px var(--glow-accent);
    height: 18px;
    width: 18px;
  }
  .site-header nav {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.1rem;
  }
  .site-header nav a {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .site-header nav a:hover { color: var(--text); }
  main { margin: 0 auto; max-width: var(--max-width); padding: clamp(1.5rem, 5vw, 3rem) 1.25rem; }
  main.wide { max-width: 1200px; }

  /* Documentation two-column shell: sticky sidebar + reading column. */
  .docs-shell {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    grid-template-columns: 260px minmax(0, 1fr);
    margin: 0 auto;
    max-width: 1180px;
    padding: 0 clamp(1rem, 4vw, 2rem);
  }
  .docs-shell main { margin: 0; max-width: 74ch; padding: clamp(1.5rem, 5vw, 2.75rem) 0; }
  .docs-aside {
    border-right: 1px solid var(--border);
  }
  .docs-aside-inner {
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding: clamp(1.5rem, 5vw, 2.75rem) 1rem 2rem 0;
    position: sticky;
    top: 0;
  }
  @media (max-width: 900px) {
    .docs-shell { display: block; padding: 0 1.25rem; }
    .docs-aside {
      border-bottom: 1px solid var(--border);
      border-right: none;
      margin: 0 -1.25rem;
      padding: 0 1.25rem;
    }
    .docs-aside-inner {
      max-height: none;
      overflow: visible;
      padding: 0.75rem 0;
      position: static;
    }
    .docs-shell main { max-width: none; }
  }
  .site-footer {
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 2rem 1.25rem;
    text-align: center;
  }
</style>
