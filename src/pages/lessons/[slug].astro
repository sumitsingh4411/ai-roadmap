---
import { getCollection, render } from 'astro:content';
import roadmapData from '../../../content/roadmap.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import CodeCopy from '../../components/CodeCopy.astro';
import { roadmapSchema, topologicalOrder } from '../../lib/roadmap';
import { buildCurriculum } from '../../lib/curriculum';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  const titleById = new Map(lessons.map((l) => [l.id, l.data.title]));
  const stages = buildCurriculum(lessons);
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson, titleById, stages },
  }));
}

const { lesson, titleById, stages } = Astro.props;
const { Content, headings } = await render(lesson);

const roadmap = roadmapSchema.parse(roadmapData);
const ordered = topologicalOrder(roadmap.nodes);
const index = ordered.findIndex((n) => n.id === lesson.id);
const previous = index > 0 ? ordered[index - 1] : null;
const next = index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : null;

const node = roadmap.nodes.find((n) => n.id === lesson.id);
const stage = roadmap.stages.find((s) => s.id === node?.stage);
const githubUrl = `https://github.com/sumitsingh4411/ai-roadmap/blob/main/content/lessons/${node?.lesson}.md`;

// Not every roadmap neighbor has a written lesson file yet (2 of 34 exist today).
// When a neighbor's real frontmatter title isn't available, fall back to a
// readable label derived from its roadmap id rather than rendering `undefined`.
const fallbackLabel = (id: string) =>
  id
    .split('-')
    .filter((w) => w.length > 0)
    .map((w) => w[0].toUpperCase() + w.slice(1))
    .join(' ');

const previousTitle = previous ? (titleById.get(previous.id) ?? fallbackLabel(previous.id)) : null;
const nextTitle = next ? (titleById.get(next.id) ?? fallbackLabel(next.id)) : null;

const tocHeadings = headings.filter((h) => h.depth === 2);

const SITE = 'https://sumitsingh4411.github.io/ai-roadmap';
const lessonSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: lesson.data.title,
    description: lesson.data.summary,
    url: `${SITE}/lessons/${lesson.id}`,
    learningResourceType: 'lesson',
    educationalLevel: lesson.data.difficulty,
    timeRequired: `PT${lesson.data.minutes}M`,
    inLanguage: 'en',
    isAccessibleForFree: true,
    keywords: lesson.data.tags?.join(', '),
    isPartOf: { '@type': 'Course', name: 'AI Roadmap', url: `${SITE}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'AI Roadmap', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: `Stage ${stage?.id} · ${stage?.name}`, item: `${SITE}/roadmap` },
      { '@type': 'ListItem', position: 3, name: lesson.data.title, item: `${SITE}/lessons/${lesson.id}` },
    ],
  },
];
---
<BaseLayout
  title={lesson.data.title}
  description={lesson.data.summary}
  keywords={lesson.data.tags?.join(', ')}
  jsonLd={lessonSchema}
>
  <Sidebar slot="sidebar" stages={stages} currentSlug={lesson.id} />

  <article class="doc">
    <header class="doc-header">
      <p class="doc-eyebrow">Stage {stage?.id} · {stage?.name}</p>
      <div class="doc-meta">
        <span>{lesson.data.minutes} min read</span>
        <span class="dot" aria-hidden="true">·</span>
        <span class="doc-difficulty">{lesson.data.difficulty}</span>
        <span class="dot" aria-hidden="true">·</span>
        <a href={githubUrl} rel="noopener">View source on GitHub ↗</a>
      </div>
    </header>

    {tocHeadings.length > 2 && (
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ul>
          {tocHeadings.map((h) => (
            <li><a href={`#${h.slug}`}>{h.text}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="prose"><Content /></div>

  <button id="mark-complete" type="button" data-slug={lesson.id} aria-pressed="false">
    Mark as complete
  </button>

  <nav class="pager" aria-label="Lesson navigation">
    {previous
      ? <a class="prev" href={href(`/lessons/${previous.id}`)}><span class="pager-dir">← Previous</span><span class="pager-title">{previousTitle}</span></a>
      : <span></span>}
    {next
      ? <a class="next" href={href(`/lessons/${next.id}`)}><span class="pager-dir">Next →</span><span class="pager-title">{nextTitle}</span></a>
      : <span></span>}
  </nav>
  </article>

  <CodeCopy />
</BaseLayout>

<style>
  .doc-header {
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.75rem;
    padding-bottom: 1.1rem;
  }
  .doc-eyebrow {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }
  .doc-meta {
    align-items: center;
    color: var(--text-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.85rem;
    gap: 0.5rem;
  }
  .doc-difficulty { text-transform: capitalize; }
  .doc-meta a { color: var(--accent-2); text-decoration: none; }
  .doc-meta a:hover { text-decoration: underline; }
  /* The lesson body's own `# Title` is the document heading. */
  .doc :global(.prose h1) {
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.025em;
    line-height: 1.12;
    margin: 0 0 1.25rem;
  }
  .toc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
  }
  .toc-title {
    color: var(--text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc a { color: var(--text-muted); font-size: 0.88rem; text-decoration: none; }
  .toc a:hover { color: var(--accent); }
  #mark-complete {
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: 999px;
    color: var(--text);
    cursor: pointer;
    font-size: 0.9rem;
    margin: 3rem 0 2rem;
    min-height: 44px;
    padding: 0.6rem 1.3rem;
    transition: background 0.2s, box-shadow 0.2s;
  }
  #mark-complete[aria-pressed='true'] {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 0 26px var(--glow-accent);
    color: #0b0a15;
    font-weight: 700;
  }
  .pager {
    border-top: 1px solid var(--border);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding-top: 1.5rem;
  }
  .pager a {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-width: 48%;
    padding: 0.7rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s;
  }
  .pager a:hover { background: var(--surface); border-color: var(--border-bright); }
  .pager .next { margin-left: auto; text-align: right; }
  .pager-dir { color: var(--text-muted); font-size: 0.75rem; }
  .pager-title { font-size: 0.9rem; font-weight: 600; }
</style>

<script>
  import { createProgressStore } from '../../lib/progress';

  const button = document.getElementById('mark-complete');
  const slug = button?.dataset.slug;

  if (button && slug) {
    const store = createProgressStore();

    function paint() {
      const done = store.isComplete(slug!);
      button!.setAttribute('aria-pressed', String(done));
      button!.textContent = done ? '✓ Completed' : 'Mark as complete';
    }

    button.addEventListener('click', () => {
      store.toggle(slug);
      paint();
    });

    paint();
  }
</script>
