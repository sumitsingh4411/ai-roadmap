---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressBar from '../components/ProgressBar.astro';
import { buildCurriculum, totalLessons } from '../lib/curriculum';
import { href } from '../lib/url';

const lessons = await getCollection('lessons');
const stages = buildCurriculum(lessons);
const total = totalLessons(stages);
const firstSlug = stages[0]?.lessons[0]?.slug;
---
<BaseLayout
  title="AI Roadmap"
  description="A free, open-source roadmap for learning AI from zero — 34 lessons from Python to LLMs, readable on the web or straight from GitHub."
  wide
>
  <section class="hero">
    <h1>Learn AI from zero — <span class="grad">one lesson at a time</span></h1>
    <p class="lede">
      {total} free lessons in dependency order, from your first line of Python to
      shipping an LLM application. Read them here, or straight from the Markdown
      on GitHub. Your progress is saved in your browser.
    </p>
    <div class="hero-actions">
      {firstSlug && <a class="btn-primary" href={href(`/lessons/${firstSlug}`)}>Start the first lesson →</a>}
      <a class="btn-ghost" href="https://github.com/sumitsingh4411/ai-roadmap" rel="noopener">View on GitHub</a>
    </div>
    <div class="hero-progress"><ProgressBar total={total} /></div>
  </section>

  <div class="curriculum">
    {stages.map((stage) => (
      <section class="stage" aria-labelledby={`stage-${stage.id}`}>
        <div class="stage-head">
          <span class="stage-num">Stage {stage.id}</span>
          <h2 id={`stage-${stage.id}`}>{stage.name}</h2>
          <span class="stage-count">{stage.lessons.length} lessons</span>
        </div>
        <ul class="lesson-list">
          {stage.lessons.map((lesson) => (
            <li>
              <a class="lesson-card" href={href(`/lessons/${lesson.slug}`)} data-card-slug={lesson.slug}>
                <span class="card-check" aria-hidden="true"></span>
                <span class="card-body">
                  <span class="card-title">{lesson.title}</span>
                  <span class="card-summary">{lesson.summary}</span>
                  <span class="card-meta">
                    <span>{lesson.minutes} min</span>
                    <span class="dot" aria-hidden="true">·</span>
                    <span class="card-difficulty">{lesson.difficulty}</span>
                  </span>
                </span>
                <span class="card-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>

<script>
  import { createProgressStore } from '../lib/progress';

  const store = createProgressStore();

  function paint() {
    const done = new Set(store.completed());
    for (const card of document.querySelectorAll<HTMLElement>('[data-card-slug]')) {
      card.dataset.done = String(done.has(card.dataset.cardSlug!));
    }
    const total = document.querySelectorAll('[data-card-slug]').length;
    const fill = document.querySelector<HTMLElement>('[data-progress-fill]');
    const label = document.querySelector<HTMLElement>('[data-progress-label]');
    const bar = document.querySelector<HTMLElement>('[role="progressbar"]');
    const percent = total === 0 ? 0 : Math.round((done.size / total) * 100);
    if (fill) fill.style.width = `${percent}%`;
    if (label) label.textContent = `${done.size} of ${total} lessons complete`;
    if (bar) bar.setAttribute('aria-valuenow', String(percent));
  }

  paint();
  window.addEventListener('storage', paint);
  window.addEventListener('pageshow', paint);
</script>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    margin: 0 auto 2.5rem;
    max-width: 60ch;
    padding: clamp(1rem, 4vw, 2.5rem) 0 2.5rem;
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.08;
    margin: 0;
  }
  .grad {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede { color: var(--text-muted); margin: 1rem auto 1.6rem; max-width: 52ch; }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.75rem;
  }
  .btn-primary,
  .btn-ghost {
    border-radius: 999px;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    text-decoration: none;
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    box-shadow: 0 8px 24px var(--glow-accent);
    color: #0b0a15;
  }
  .btn-ghost { border: 1px solid var(--border-bright); color: var(--text); }
  .btn-ghost:hover { background: var(--surface); }
  .hero-progress { margin: 0 auto; max-width: 34rem; }

  .curriculum { margin: 0 auto; max-width: 60rem; }
  .stage { margin-bottom: 2.5rem; }
  .stage-head {
    align-items: baseline;
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
  }
  .stage-num {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .stage-head h2 { font-size: 1.35rem; letter-spacing: -0.02em; margin: 0; }
  .stage-count { color: var(--text-muted); font-size: 0.8rem; margin-left: auto; }

  .lesson-list { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); list-style: none; margin: 0; padding: 0; }
  .lesson-card {
    align-items: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    display: flex;
    gap: 0.75rem;
    height: 100%;
    padding: 0.9rem 1rem;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .lesson-card:hover {
    background: var(--surface-strong);
    border-color: var(--border-bright);
    transform: translateY(-2px);
  }
  .card-check {
    border: 1.5px solid var(--border-bright);
    border-radius: 50%;
    flex-shrink: 0;
    height: 18px;
    margin-top: 0.15rem;
    position: relative;
    width: 18px;
  }
  [data-card-slug][data-done='true'] .card-check {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
  }
  [data-card-slug][data-done='true'] .card-check::after {
    color: #0b0a15;
    content: '✓';
    font-size: 11px;
    font-weight: 900;
    left: 50%;
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
  }
  .card-body { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .card-title { font-size: 0.95rem; font-weight: 650; line-height: 1.25; }
  .card-summary { color: var(--text-muted); font-size: 0.83rem; line-height: 1.4; }
  .card-meta { color: var(--text-muted); display: flex; font-size: 0.75rem; gap: 0.4rem; margin-top: 0.15rem; }
  .card-difficulty { text-transform: capitalize; }
  .card-arrow { color: var(--text-muted); margin-left: auto; transition: transform 0.2s; }
  .lesson-card:hover .card-arrow { color: var(--accent); transform: translateX(3px); }
</style>
