---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { buildCurriculum, totalLessons } from '../lib/curriculum';
import { href } from '../lib/url';

const lessons = await getCollection('lessons');
const stages = buildCurriculum(lessons);
const total = totalLessons(stages);
const firstSlug = stages[0]?.lessons[0]?.slug;
const totalMinutes = lessons.reduce((n, l) => n + (l.data.minutes ?? 0), 0);
const totalHours = Math.round(totalMinutes / 60);

// Per-stage hue (a violet→rose spectrum down the spine) and an editorial blurb.
const HUE: Record<string, string> = {
  violet: '#a78bfa', indigo: '#818cf8', sky: '#38bdf8', cyan: '#22d3ee',
  teal: '#2dd4bf', amber: '#fbbf24', rose: '#fb7185',
};
const SITE = 'https://sumitsingh4411.github.io/ai-roadmap';
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'AI Roadmap — Learn AI from Zero',
  description:
    `A free, open-source roadmap to learn AI: ${total} dependency-ordered lessons from your first line of Python through classical ML, deep learning, and large language models, to shipping an LLM app.`,
  url: `${SITE}/`,
  image: `${SITE}/og.png`,
  inLanguage: 'en',
  isAccessibleForFree: true,
  educationalLevel: 'Beginner to Advanced',
  datePublished: '2026-07-24',
  keywords: 'learn AI, AI roadmap, machine learning, deep learning, LLM, generative AI, Python',
  about: ['Artificial Intelligence', 'Machine Learning', 'Deep Learning', 'Large Language Models', 'Data Science'],
  teaches: ['Python', 'NumPy', 'pandas', 'Machine Learning', 'Deep Learning', 'PyTorch', 'Transformers', 'Large Language Models', 'RAG', 'MLOps'],
  provider: { '@type': 'Organization', name: 'AI Roadmap', url: `${SITE}/` },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD', category: 'Free' },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: `PT${totalHours}H`,
    instructor: { '@type': 'Organization', name: 'AI Roadmap' },
  },
  hasPart: stages.map((s) => ({ '@type': 'Course', name: `Stage ${s.id}: ${s.name}`, url: `${SITE}/roadmap` })),
};

// FAQ targets real questions people search for — and earns FAQ rich results.
const faqs = [
  { q: 'Is this AI roadmap free?', a: 'Yes — completely free and open source. All 34 lessons are free to read on the site or straight from the Markdown on GitHub, with no sign-up, paywall, or ads.' },
  { q: 'How long does it take to learn AI with this roadmap?', a: `The ${total} lessons are about ${totalHours} hours of reading, plus time to run the code and do the exercises. Most people spread it over a few months of steady study — you can go faster or slower, and your progress saves as you go.` },
  { q: 'Do I need a math or computer science degree to learn AI?', a: 'No. The roadmap starts from zero and teaches the math you actually need — linear algebra, calculus, and statistics — through the problems it solves, not as abstract theory.' },
  { q: 'What should I learn first for AI?', a: 'Start with what AI, machine learning, and deep learning actually are, then Python and working with data. Everything here is ordered by dependency, so you always know exactly what to learn next.' },
  { q: 'Can I learn AI on my own as a self-taught beginner?', a: 'Yes — this is built for self-taught learners: a clear ordered path, runnable code examples, and exercises, so you never have to guess what to study or in what order.' },
  { q: 'Do I need to know Python before starting?', a: 'No. Python is the first hands-on stage of the roadmap. If you already know it, you can skip ahead — every lesson lists its prerequisites.' },
  { q: 'Does it cover LLMs like ChatGPT?', a: 'Yes. The later stages cover how large language models work, prompt engineering, embeddings, RAG, fine-tuning, and building AI agents.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const BLURB: Record<number, string> = {
  0: 'Get the lay of the land before you write a line of code.',
  1: "The tools you'll touch every day — Python, NumPy, pandas, plots.",
  2: 'Just enough linear algebra, calculus, and statistics — taught through the problems they solve.',
  3: 'Regression to random forests: how machines learn from tables of data.',
  4: 'Neural networks, from a single neuron up to the transformer.',
  5: 'How modern language models actually work, and how to build with them.',
  6: 'Take a model off your laptop and put it in front of real users.',
};
---
<BaseLayout
  title="AI Roadmap"
  description="A free, open-source roadmap to learn AI from zero — 34 lessons from your first line of Python through machine learning and deep learning to shipping an LLM app. Read on the web or straight from GitHub."
  keywords="AI roadmap for beginners, learn AI free, machine learning course, LLM roadmap"
  jsonLd={[courseSchema, faqSchema]}
  wide
>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="bloom bloom-a"></span>
      <span class="bloom bloom-b"></span>
      <span class="bloom bloom-c"></span>
      <span class="hero-grid"></span>
    </div>
    <div class="hero-inner">
      <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{total} lessons · dependency-ordered</p>
      <h1>From your first line of Python<br />to <span class="grad">shipping AI</span>.</h1>
      <p class="sub">
        A free, open-source roadmap through the whole field. Read it here or straight
        from the Markdown on GitHub — and your progress saves as you go.
      </p>
      <div class="cta-row">
        {firstSlug && <a class="cta-primary" href={href(`/lessons/${firstSlug}`)}>Start the first lesson →</a>}
        <a class="cta-ghost" href="https://github.com/sumitsingh4411/ai-roadmap" rel="noopener">Browse on GitHub</a>
      </div>
      <dl class="stats">
        <div><dt data-progress-stat>0</dt><dd>completed</dd></div>
        <div><dt>{total}</dt><dd>lessons</dd></div>
        <div><dt>{stages.length}</dt><dd>stages</dd></div>
        <div><dt>~{totalHours}h</dt><dd>of reading</dd></div>
      </dl>
      <div class="hero-track" aria-hidden="true"><span data-progress-fill></span></div>
    </div>
  </section>

  <div class="docs">
    <aside class="home-nav"><Sidebar stages={stages} /></aside>

    <div class="stages" role="region" aria-label="Curriculum">
      {stages.map((stage, i) => (
        <section
          class="stage"
          data-stage-id={stage.id}
          style={`--hue:${HUE[stage.color] ?? '#a78bfa'}`}
        >
          <div class="rail" aria-hidden="true">
            <span class="thread" data-first={i === 0 ? '' : undefined} data-last={i === stages.length - 1 ? '' : undefined}></span>
            <span class="node"><span class="node-dot"></span></span>
          </div>
          <div class="stage-main">
            <header class="stage-head">
              <p class="stage-kicker"><span class="stage-num">Stage {String(stage.id).padStart(2, '0')}</span> · {stage.lessons.length} lessons</p>
              <h2 id={`stage-${stage.id}`}>{stage.name}</h2>
              <p class="stage-blurb">{BLURB[stage.id]}</p>
            </header>
            <ul class="cards">
              {stage.lessons.map((lesson) => (
                <li>
                  <a class="card" href={href(`/lessons/${lesson.slug}`)} data-card-slug={lesson.slug}>
                    <span class="card-tick" aria-hidden="true"></span>
                    <span class="card-body">
                      <span class="card-title">{lesson.title}</span>
                      <span class="card-sum">{lesson.summary}</span>
                    </span>
                    <span class="card-foot">
                      <span class="card-min">{lesson.minutes} min</span>
                      <span class="card-diff">{lesson.difficulty}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
    </div>
  </div>

  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Frequently asked questions</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import { createProgressStore } from '../lib/progress';
  const store = createProgressStore();

  function paint() {
    const done = new Set(store.completed());

    // Lesson cards.
    const cards = document.querySelectorAll<HTMLElement>('[data-card-slug]');
    for (const c of cards) c.dataset.done = String(done.has(c.dataset.cardSlug!));

    // Stage spine: a stage lights up once every lesson in it is complete.
    for (const stage of document.querySelectorAll<HTMLElement>('.stage')) {
      const slugs = [...stage.querySelectorAll<HTMLElement>('[data-card-slug]')].map((c) => c.dataset.cardSlug!);
      const complete = slugs.length > 0 && slugs.every((s) => done.has(s));
      const started = slugs.some((s) => done.has(s));
      stage.dataset.done = String(complete);
      stage.dataset.started = String(started && !complete);
    }

    // Hero stat + track.
    const total = cards.length;
    const pct = total === 0 ? 0 : Math.round((done.size / total) * 100);
    const stat = document.querySelector<HTMLElement>('[data-progress-stat]');
    const fill = document.querySelector<HTMLElement>('[data-progress-fill]');
    if (stat) stat.textContent = String(done.size);
    if (fill) fill.style.width = `${pct}%`;
  }

  paint();
  window.addEventListener('storage', paint);
  window.addEventListener('pageshow', paint);
</script>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    border: 1px solid var(--border);
    border-radius: 24px;
    margin-bottom: 3rem;
    overflow: hidden;
    position: relative;
  }
  .hero-bg { inset: 0; position: absolute; }
  .bloom { border-radius: 50%; filter: blur(60px); opacity: 0.75; position: absolute; }
  .bloom-a { background: radial-gradient(circle, rgba(139,92,246,0.55), transparent 68%); height: 520px; left: -8%; top: -32%; width: 520px; }
  .bloom-b { background: radial-gradient(circle, rgba(34,211,238,0.38), transparent 68%); height: 460px; right: -6%; top: -10%; width: 460px; }
  .bloom-c { background: radial-gradient(circle, rgba(251,113,133,0.28), transparent 70%); bottom: -40%; height: 440px; left: 40%; width: 440px; }
  .hero-grid {
    inset: 0;
    position: absolute;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(120% 120% at 50% 0%, #000 30%, transparent 72%);
    opacity: 0.6;
  }
  :root[data-theme='light'] .bloom { opacity: 0.5; }

  .hero-inner {
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    position: relative;
  }
  .eyebrow {
    align-items: center;
    color: var(--text-muted);
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    gap: 0.5rem;
    letter-spacing: 0.04em;
    margin: 0 0 1.1rem;
    text-transform: uppercase;
  }
  .pulse {
    background: var(--accent-2);
    border-radius: 50%;
    box-shadow: 0 0 0 0 var(--glow-accent-2);
    height: 8px;
    width: 8px;
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(34, 211, 238, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 211, 238, 0); }
  }
  .hero h1 {
    font-size: clamp(2.1rem, 5.5vw, 3.9rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 0;
    max-width: 18ch;
  }
  .grad {
    background: linear-gradient(100deg, var(--violet-400), var(--cyan-300));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub {
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.55;
    margin: 1.15rem 0 1.75rem;
    max-width: 52ch;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 2rem; }
  .cta-primary, .cta-ghost {
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.7rem 1.4rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
  }
  .cta-primary {
    background: linear-gradient(135deg, var(--violet-500), var(--cyan-400));
    box-shadow: 0 10px 30px var(--glow-accent);
    color: #08060f;
  }
  .cta-primary:hover { box-shadow: 0 14px 40px var(--glow-accent); transform: translateY(-2px); }
  .cta-ghost { border: 1px solid var(--border-bright); color: var(--text); }
  .cta-ghost:hover { background: var(--surface); }

  .stats {
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    margin: 0 0 1.5rem;
    padding-top: 1.5rem;
  }
  .stats div { display: flex; flex-direction: column; gap: 0.15rem; }
  .stats dt {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .stats dd { color: var(--text-muted); font-size: 0.78rem; letter-spacing: 0.02em; margin: 0; }
  .hero-track { background: var(--surface-strong); border-radius: 999px; height: 4px; overflow: hidden; }
  .hero-track span {
    background: linear-gradient(90deg, var(--violet-400), var(--cyan-300));
    border-radius: 999px;
    display: block;
    height: 100%;
    transition: width 0.5s ease;
    width: 0;
  }

  /* ---------------- Docs grid ---------------- */
  .docs { display: grid; gap: clamp(1.5rem, 4vw, 3rem); grid-template-columns: 250px minmax(0, 1fr); }
  .home-nav {
    align-self: start;
    border-right: 1px solid var(--border);
    max-height: calc(100vh - 3rem);
    overflow-y: auto;
    padding-right: 1rem;
    position: sticky;
    top: 1.5rem;
  }

  /* ---------------- Stage + spine signature ---------------- */
  .stages { min-width: 0; }
  .stage { display: grid; grid-template-columns: 40px minmax(0, 1fr); }
  .rail { position: relative; }
  .thread {
    background: var(--border-bright);
    border-radius: 2px;
    left: 19px;
    position: absolute;
    top: 0;
    bottom: -1px;
    width: 2px;
  }
  .thread[data-first] { top: 14px; }
  .thread[data-last] { bottom: auto; height: 30px; }
  .node {
    align-items: center;
    background: var(--bg);
    border: 2px solid var(--border-bright);
    border-radius: 50%;
    display: flex;
    height: 26px;
    justify-content: center;
    left: 7px;
    position: absolute;
    top: 4px;
    transition: border-color 0.3s, box-shadow 0.3s;
    width: 26px;
    z-index: 1;
  }
  .node-dot { background: var(--border-bright); border-radius: 50%; height: 8px; transition: background 0.3s; width: 8px; }

  /* stage in progress: node adopts the stage hue */
  .stage[data-started='true'] .node { border-color: var(--hue); box-shadow: 0 0 14px -2px var(--hue); }
  .stage[data-started='true'] .node-dot { background: var(--hue); }
  /* stage complete: filled node + glowing thread */
  .stage[data-done='true'] .node { background: var(--hue); border-color: var(--hue); box-shadow: 0 0 18px -2px var(--hue); }
  .stage[data-done='true'] .node-dot { background: #08060f; }
  .stage[data-done='true'] .thread { background: linear-gradient(180deg, var(--hue), color-mix(in srgb, var(--hue) 40%, var(--border-bright))); box-shadow: 0 0 12px -4px var(--hue); }

  .stage-main { min-width: 0; padding-bottom: 2.75rem; }
  .stage-head { margin-bottom: 1.1rem; }
  .stage-kicker {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    margin: 0 0 0.3rem;
    text-transform: uppercase;
  }
  .stage-num { color: var(--hue); }
  .stage-head h2 { font-size: clamp(1.3rem, 2.5vw, 1.6rem); letter-spacing: -0.025em; margin: 0; }
  .stage-blurb { color: var(--text-muted); font-size: 0.92rem; margin: 0.35rem 0 0; max-width: 60ch; }

  .cards { display: grid; gap: 0.7rem; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); list-style: none; margin: 0; padding: 0; }
  .card {
    background: linear-gradient(160deg, var(--surface-strong), var(--surface));
    border: 1px solid var(--border);
    border-radius: 14px;
    color: var(--text);
    display: grid;
    gap: 0.55rem;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    padding: 0.9rem 1rem 0.8rem;
    position: relative;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .card::before {
    border-radius: 14px;
    content: '';
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    box-shadow: 0 12px 34px -12px var(--hue);
    transition: opacity 0.2s;
  }
  .card:hover { border-color: color-mix(in srgb, var(--hue) 55%, var(--border)); transform: translateY(-3px); }
  .card:hover::before { opacity: 1; }
  .card:focus-visible { outline: 2px solid var(--hue); outline-offset: 3px; }
  .card-tick {
    border: 1.5px solid var(--border-bright);
    border-radius: 50%;
    height: 17px;
    position: relative;
    width: 17px;
  }
  [data-card-slug][data-done='true'] .card-tick { background: var(--hue); border-color: transparent; }
  [data-card-slug][data-done='true'] .card-tick::after {
    color: #08060f; content: '✓'; font-size: 10px; font-weight: 900;
    left: 50%; position: absolute; top: 50%; transform: translate(-50%, -50%);
  }
  .card-body { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .card-title { font-size: 0.95rem; font-weight: 650; line-height: 1.25; }
  .card-sum { color: var(--text-muted); font-size: 0.82rem; line-height: 1.4; }
  .card-foot {
    align-items: center;
    color: var(--text-muted);
    display: flex;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    gap: 0.6rem;
    justify-content: space-between;
    letter-spacing: 0.02em;
    padding-top: 0.2rem;
  }
  .card-diff { text-transform: uppercase; }

  /* ---------------- Motion + responsive ---------------- */
  .hero-inner > * { animation: rise 0.6s cubic-bezier(0.2, 0.8, 0.25, 1) backwards; }
  .hero-inner > :nth-child(2) { animation-delay: 0.06s; }
  .hero-inner > :nth-child(3) { animation-delay: 0.12s; }
  .hero-inner > :nth-child(4) { animation-delay: 0.18s; }
  .hero-inner > :nth-child(5) { animation-delay: 0.24s; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .bloom { animation: drift 16s ease-in-out infinite alternate; }
  .bloom-b { animation-duration: 20s; }
  .bloom-c { animation-duration: 24s; }
  @keyframes drift { to { transform: translate3d(24px, 18px, 0) scale(1.08); } }

  @media (max-width: 900px) {
    .docs { display: block; }
    .home-nav {
      border-bottom: 1px solid var(--border);
      border-right: none;
      margin-bottom: 1.5rem;
      max-height: none;
      overflow: visible;
      padding-right: 0;
      position: static;
    }
    .stage { grid-template-columns: 28px minmax(0, 1fr); }
    .thread { left: 13px; }
    .node { left: 1px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-inner > *, .bloom, .pulse { animation: none; }
  }

  /* FAQ */
  .faq { border-top: 1px solid var(--border); margin: 3rem auto 0; max-width: 46rem; padding-top: 2.5rem; }
  .faq h2 { font-size: 1.5rem; letter-spacing: -0.02em; margin: 0 0 1.25rem; text-align: center; }
  .faq-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .faq-item { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0 1.1rem; transition: border-color 0.2s; }
  .faq-item[open] { border-color: var(--border-bright); }
  .faq-item summary { cursor: pointer; font-size: 1rem; font-weight: 600; list-style: none; padding: 1rem 1.6rem 1rem 0; position: relative; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { color: var(--accent); content: '+'; font-size: 1.4rem; position: absolute; right: 0.2rem; top: 50%; transform: translateY(-50%); }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--text-muted); line-height: 1.6; margin: 0; padding: 0 0 1.1rem; }
</style>
