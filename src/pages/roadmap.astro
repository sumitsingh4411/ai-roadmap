---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildCurriculum, totalLessons } from '../lib/curriculum';
import { href } from '../lib/url';

const lessons = await getCollection('lessons');
const stages = buildCurriculum(lessons);
const total = totalLessons(stages);

const HUE: Record<string, string> = {
  violet: '#a78bfa', indigo: '#818cf8', sky: '#38bdf8', cyan: '#22d3ee',
  teal: '#2dd4bf', amber: '#fbbf24', rose: '#fb7185',
};

const SITE = 'https://sumitsingh4411.github.io/ai-roadmap';
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI Roadmap — the full learning path',
  numberOfItems: total,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: stages.flatMap((s) =>
    s.lessons.map((l, idx) => ({ '@type': 'ListItem', position: idx + 1, name: l.title, url: `${SITE}/lessons/${l.slug}` })),
  ),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'AI Roadmap', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Roadmap', item: `${SITE}/roadmap` },
  ],
};

// Ordered stream: a stage marker, then its lessons, alternating sides.
type Row =
  | { kind: 'stage'; id: number; name: string; count: number; hue: string }
  | { kind: 'lesson'; slug: string; title: string; minutes: number; difficulty: string; tags: string[]; hue: string; side: 'left' | 'right' };
const rows: Row[] = [];
let i = 0;
for (const stage of stages) {
  const hue = HUE[stage.color] ?? '#a78bfa';
  rows.push({ kind: 'stage', id: stage.id, name: stage.name, count: stage.lessons.length, hue });
  for (const l of stage.lessons) {
    rows.push({ kind: 'lesson', slug: l.slug, title: l.title, minutes: l.minutes, difficulty: l.difficulty, tags: l.tags.slice(0, 2), hue, side: i % 2 === 0 ? 'left' : 'right' });
    i++;
  }
}
---
<BaseLayout
  title="Roadmap"
  description={`The complete AI learning path as one interactive winding roadmap — ${total} topics from Python to LLMs, in dependency order. Click any topic to jump straight into the lesson.`}
  keywords="AI learning path, machine learning roadmap, AI topics list, what to learn for AI"
  jsonLd={[itemListSchema, breadcrumbSchema]}
  wide
>
  <header class="rm-head">
    <p class="rm-eyebrow">The path</p>
    <h1>Follow the road, <span class="grad">one topic at a time</span></h1>
    <p class="rm-sub">
      Every lesson in order, wired together the way it depends. Click any stop to jump
      straight into it — the road lights up behind you as you complete lessons.
    </p>
    <p class="rm-legend">
      <span><i class="lg lg-done"></i> completed</span>
      <span><i class="lg lg-next"></i> up next</span>
      <span><i class="lg lg-todo"></i> to do</span>
      <span class="rm-count" data-rm-count>0 / {total}</span>
    </p>
  </header>

  <div class="timeline" data-timeline>
    <svg class="road" aria-hidden="true" preserveAspectRatio="none">
      <defs>
        <linearGradient id="roadGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#a78bfa" />
          <stop offset="0.5" stop-color="#22d3ee" />
          <stop offset="1" stop-color="#fb7185" />
        </linearGradient>
      </defs>
      <g class="road-connectors"></g>
      <path class="road-base" fill="none" />
      <path class="road-done" fill="none" />
    </svg>
    <span class="runner" aria-hidden="true"></span>

    {rows.map((row) => (
      row.kind === 'stage' ? (
        <div class="tl-stage" style={`--hue:${row.hue}`} data-stage-id={row.id}>
          <span class="tl-stage-node" data-anchor aria-hidden="true"><b>{row.id}</b></span>
          <span class="tl-stage-label">Stage {row.id} — {row.name} <em>· {row.count}</em></span>
        </div>
      ) : (
        <div class={`tl-item ${row.side}`} style={`--hue:${row.hue}`}>
          <span class="tl-node" data-anchor aria-hidden="true"></span>
          <a class="tl-card" href={href(`/lessons/${row.slug}`)} data-rm-slug={row.slug}>
            <span class="tl-title">{row.title}</span>
            <span class="tl-meta">{row.minutes} min · {row.difficulty}</span>
            {row.tags.length > 0 && (
              <span class="tl-tags">{row.tags.map((t) => <span class="tl-tag">{t}</span>)}</span>
            )}
          </a>
        </div>
      )
    ))}

    <div class="tl-finish"><span>🎓 You made it</span></div>
  </div>
</BaseLayout>

<script>
  import { createProgressStore } from '../lib/progress';
  const store = createProgressStore();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Smooth Catmull-Rom path through the anchor points.
  function smooth(pts: { x: number; y: number }[]): string {
    if (pts.length < 2) return '';
    let d = `M${pts[0].x.toFixed(1)},${pts[0].y.toFixed(1)}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
      const c1x = p1.x + (p2.x - p0.x) / 6, c1y = p1.y + (p2.y - p0.y) / 6;
      const c2x = p2.x - (p3.x - p1.x) / 6, c2y = p2.y - (p3.y - p1.y) / 6;
      d += ` C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
    }
    return d;
  }

  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  const svg = document.querySelector<SVGSVGElement>('.road');
  const base = document.querySelector<SVGPathElement>('.road-base');
  const doneP = document.querySelector<SVGPathElement>('.road-done');
  const runner = document.querySelector<HTMLElement>('.runner');

  function drawRoad() {
    if (!tl || !svg || !base || !doneP) return;
    const anchors = [...tl.querySelectorAll<HTMLElement>('[data-anchor]')];
    const box = tl.getBoundingClientRect();
    const pts = anchors.map((a) => {
      const r = a.getBoundingClientRect();
      return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
    });
    if (pts.length < 2) return;

    const w = tl.clientWidth, h = tl.clientHeight;
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    svg.setAttribute('width', String(w));
    svg.setAttribute('height', String(h));

    const full = smooth(pts);
    base.setAttribute('d', full);

    // A connector from each topic card to its node on the road, in the stage hue.
    const done = new Set(store.completed());
    const conns = svg.querySelector('.road-connectors');
    if (conns) {
      conns.innerHTML = '';
      for (const item of tl.querySelectorAll<HTMLElement>('.tl-item')) {
        const card = item.querySelector<HTMLElement>('.tl-card');
        const node = item.querySelector<HTMLElement>('.tl-node');
        if (!card || !node) continue;
        const cr = card.getBoundingClientRect(), nr = node.getBoundingClientRect();
        const isLeft = item.classList.contains('left');
        const cx = (isLeft ? cr.right : cr.left) - box.left;
        const cy = cr.top + cr.height / 2 - box.top;
        const nx = nr.left + nr.width / 2 - box.left;
        const ny = nr.top + nr.height / 2 - box.top;
        const hue = getComputedStyle(item).getPropertyValue('--hue').trim() || '#a78bfa';
        const isDone = done.has(item.querySelector<HTMLElement>('[data-rm-slug]')?.dataset.rmSlug ?? '');
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        line.setAttribute('d', `M${cx.toFixed(1)},${cy.toFixed(1)} Q${((cx + nx) / 2).toFixed(1)},${cy.toFixed(1)} ${nx.toFixed(1)},${ny.toFixed(1)}`);
        line.setAttribute('stroke', hue);
        line.setAttribute('stroke-width', '1.5');
        line.setAttribute('fill', 'none');
        line.setAttribute('stroke-linecap', 'round');
        line.setAttribute('opacity', isDone ? '0.9' : '0.4');
        conns.appendChild(line);
      }
    }

    // Light the road up to (and including) the last completed lesson.
    const lessonAnchors = anchors.map((a, idx) => ({ idx, slug: a.parentElement?.querySelector<HTMLElement>('[data-rm-slug]')?.dataset.rmSlug }));
    let lastDone = -1;
    for (const la of lessonAnchors) if (la.slug && done.has(la.slug)) lastDone = la.idx;
    doneP.setAttribute('d', lastDone >= 1 ? smooth(pts.slice(0, lastDone + 1)) : '');

    if (runner && !reduce.matches) {
      runner.style.setProperty('offset-path', `path('${full}')`);
      runner.style.opacity = '1';
    }
  }

  function paint() {
    const done = new Set(store.completed());
    const items = [...document.querySelectorAll<HTMLElement>('[data-rm-slug]')];
    let markedNext = false;
    for (const item of items) {
      const parent = item.closest<HTMLElement>('.tl-item')!;
      const isDone = done.has(item.dataset.rmSlug!);
      parent.dataset.state = isDone ? 'done' : (!markedNext ? 'next' : 'todo');
      if (!isDone) markedNext = true;
    }
    const markers = [...document.querySelectorAll<HTMLElement>('.tl-stage')];
    markers.forEach((marker, idx) => {
      const next = markers[idx + 1] ?? null;
      const slugs: string[] = [];
      let el = marker.nextElementSibling;
      while (el && el !== next) {
        const s = el.querySelector<HTMLElement>('[data-rm-slug]');
        if (s) slugs.push(s.dataset.rmSlug!);
        el = el.nextElementSibling;
      }
      marker.dataset.done = String(slugs.length > 0 && slugs.every((s) => done.has(s)));
    });
    const count = document.querySelector<HTMLElement>('[data-rm-count]');
    if (count) count.textContent = `${done.size} / ${items.length}`;
    drawRoad();
  }

  const redraw = () => requestAnimationFrame(paint);
  redraw();
  window.addEventListener('load', redraw);
  window.addEventListener('resize', () => { clearTimeout((window as any).__rt); (window as any).__rt = setTimeout(redraw, 150); });
  window.addEventListener('storage', redraw);
  window.addEventListener('pageshow', redraw);
</script>

<style>
  .rm-head { margin: 0 auto 2rem; max-width: 62ch; text-align: center; }
  .rm-eyebrow { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; margin: 0 0 0.6rem; text-transform: uppercase; }
  .rm-head h1 { font-size: clamp(1.9rem, 5vw, 3rem); letter-spacing: -0.03em; line-height: 1.08; margin: 0; }
  .grad { background: linear-gradient(100deg, var(--violet-400), var(--cyan-300)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .rm-sub { color: var(--text-muted); font-size: 1.02rem; margin: 1rem auto 1.4rem; max-width: 52ch; }
  .rm-legend { align-items: center; color: var(--text-muted); display: flex; flex-wrap: wrap; font-size: 0.8rem; gap: 1rem; justify-content: center; margin: 0; }
  .rm-legend span { align-items: center; display: inline-flex; gap: 0.4rem; }
  .lg { border-radius: 50%; height: 11px; width: 11px; }
  .lg-done { background: linear-gradient(135deg, var(--violet-400), var(--cyan-300)); }
  .lg-next { background: var(--cyan-400); box-shadow: 0 0 8px var(--cyan-400); }
  .lg-todo { border: 1.5px solid var(--border-bright); }
  .rm-count { color: var(--text); font-family: var(--font-mono); font-weight: 600; }

  /* ---------- Winding road ---------- */
  .timeline { margin: 0 auto; max-width: 760px; padding: 1.5rem 0 3rem; position: relative; }
  .road { inset: 0; pointer-events: none; position: absolute; z-index: 0; }
  .road-base { stroke: url(#roadGrad); stroke-width: 3; stroke-linecap: round; opacity: 0.32; }
  .road-done { stroke: url(#roadGrad); stroke-width: 4; stroke-linecap: round; filter: drop-shadow(0 0 6px rgba(139, 92, 246, 0.6)); transition: none; }
  .runner {
    background: #fff; border-radius: 50%; box-shadow: 0 0 10px 3px var(--cyan-300), 0 0 20px 6px rgba(34, 211, 238, 0.4);
    height: 11px; left: 0; opacity: 0; position: absolute; top: 0; width: 11px; z-index: 1;
    offset-anchor: 50% 50%; offset-rotate: 0deg; animation: run 9s linear infinite;
  }
  @keyframes run { from { offset-distance: 0%; } to { offset-distance: 100%; } }

  /* Stage marker */
  .tl-stage { align-items: center; display: flex; flex-direction: column; gap: 0.5rem; margin: 2rem 0 1.25rem; position: relative; z-index: 2; }
  .tl-stage-node {
    align-items: center; background: var(--bg-raised); border: 2px solid var(--hue); border-radius: 50%;
    box-shadow: 0 0 20px -4px var(--hue); color: var(--hue); display: flex; font-family: var(--font-mono);
    font-size: 0.9rem; font-weight: 700; height: 42px; justify-content: center; transition: background 0.3s, color 0.3s, box-shadow 0.3s; width: 42px;
  }
  .tl-stage[data-done='true'] .tl-stage-node { background: var(--hue); box-shadow: 0 0 30px -3px var(--hue); color: #08060f; }
  .tl-stage-label { color: var(--text); font-size: 0.82rem; font-weight: 700; }
  .tl-stage-label em { color: var(--text-muted); font-style: normal; }

  /* Lesson node: card on its side, anchor dot woven onto the road */
  .tl-item { margin: 0.4rem 0; position: relative; z-index: 1; }
  .tl-node {
    background: var(--bg-raised); border: 2px solid var(--border-bright); border-radius: 50%;
    height: 16px; left: 41%; position: absolute; top: 50%; transform: translate(-50%, -50%); transition: background 0.25s, border-color 0.25s, box-shadow 0.25s; width: 16px; z-index: 2;
  }
  .tl-item.right .tl-node { left: 59%; }
  .tl-card {
    background: linear-gradient(160deg, var(--surface-strong), var(--surface)); border: 1px solid var(--border);
    border-radius: 12px; color: var(--text); display: inline-flex; flex-direction: column; gap: 0.2rem;
    max-width: 38%; padding: 0.7rem 0.95rem; position: relative; text-decoration: none;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .tl-item.left .tl-card { margin-right: 62%; text-align: right; align-items: flex-end; }
  .tl-item.right .tl-card { margin-left: 62%; }
  .tl-card:hover { border-color: color-mix(in srgb, var(--hue) 60%, var(--border)); box-shadow: 0 14px 34px -14px var(--hue); transform: translateY(-2px); }
  .tl-card:focus-visible { outline: 2px solid var(--hue); outline-offset: 3px; }
  .tl-title { font-size: 0.92rem; font-weight: 650; line-height: 1.25; }
  .tl-meta { color: var(--text-muted); font-family: var(--font-mono); font-size: 0.7rem; }
  .tl-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.35rem; }
  .tl-item.left .tl-tags { justify-content: flex-end; }
  .tl-tag {
    background: color-mix(in srgb, var(--hue) 14%, transparent); border: 1px solid color-mix(in srgb, var(--hue) 35%, var(--border));
    border-radius: 999px; color: color-mix(in srgb, var(--hue) 75%, var(--text)); font-family: var(--font-mono);
    font-size: 0.62rem; letter-spacing: 0.02em; padding: 0.1rem 0.5rem;
  }

  /* completion states */
  .tl-item[data-state='done'] .tl-node { background: var(--hue); border-color: var(--hue); box-shadow: 0 0 16px -2px var(--hue); }
  .tl-item[data-state='done'] .tl-title { color: var(--text-muted); }
  .tl-item[data-state='next'] .tl-node { border-color: var(--cyan-400); box-shadow: 0 0 14px -1px var(--cyan-400); }
  .tl-item[data-state='next'] .tl-card { border-color: color-mix(in srgb, var(--cyan-400) 55%, var(--border)); }

  .tl-finish { margin-top: 1.5rem; position: relative; text-align: center; z-index: 2; }
  .tl-finish span { background: linear-gradient(135deg, var(--violet-500), var(--cyan-400)); border-radius: 999px; color: #08060f; display: inline-block; font-size: 0.85rem; font-weight: 700; padding: 0.5rem 1.1rem; }

  @media (max-width: 640px) {
    .tl-node, .tl-item.right .tl-node { left: 22px; }
    .tl-stage { align-items: flex-start; padding-left: 3.2rem; }
    .tl-stage-node { left: 1px; position: absolute; }
    .tl-card, .tl-item.left .tl-card, .tl-item.right .tl-card { align-items: flex-start; margin: 0 0 0 3.2rem; max-width: calc(100% - 3.4rem); text-align: left; }
    .tl-item.left .tl-tags { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .runner { display: none; }
  }
</style>
